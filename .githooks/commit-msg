#!/bin/sh
# Enforce Conventional Commits on the subject line.
# Activate once per clone:  git config core.hooksPath .githooks
# See CONTRIBUTING.md.

msg_file=$1
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Allow git-generated messages.
case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Reapply "*)
        exit 0
        ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|build|ci|perf|style|revert)(\([a-z0-9:_-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
    exit 0
fi

cat >&2 <<'EOF'
✖ Commit message rejected — the subject line is not a Conventional Commit.

  <type>(<optional scope>): <description>

  type:  feat | fix | chore | docs | refactor | test | build | ci | perf | style | revert
  scope: a module, lowercase, e.g. (home), (core:designsystem), (data)

  examples:
    feat(recipedetail): build screen from Figma 371:728
    fix(home): stop XP bar overflowing on small screens
    chore: bump detekt to 2.0.0-alpha.7

EOF
exit 1
