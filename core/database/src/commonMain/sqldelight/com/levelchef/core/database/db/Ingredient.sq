-- The user's pantry of logged ingredients. Enum columns store the enum `name`; the macro columns
-- are nullable (NULL across all four == "no nutritional values"). Default rows are seeded by
-- IngredientRepositoryImpl.seedDefaults(), not here; `ingredientSeed` remembers that it ran, so a
-- pantry the user empties by hand stays empty instead of being re-seeded on the next launch.
CREATE TABLE ingredient (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    emoji TEXT NOT NULL,
    defaultUnit TEXT,
    calories INTEGER,
    proteinGrams REAL,
    carbsGrams REAL,
    fatGrams REAL,
    imageUrl TEXT
);

-- Single-row flag (id is always 1): present once the default pantry has been seeded.
CREATE TABLE ingredientSeed (
    id INTEGER NOT NULL PRIMARY KEY
);

selectAll:
SELECT * FROM ingredient ORDER BY name;

selectById:
SELECT * FROM ingredient WHERE id = ?;

countAll:
SELECT COUNT(*) FROM ingredient;

upsert:
INSERT OR REPLACE INTO ingredient(id, name, category, emoji, defaultUnit, calories, proteinGrams, carbsGrams, fatGrams, imageUrl)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM ingredient WHERE id = ?;

deleteAll:
DELETE FROM ingredient;

isSeeded:
SELECT EXISTS(SELECT 1 FROM ingredientSeed WHERE id = 1);

markSeeded:
INSERT OR IGNORE INTO ingredientSeed(id) VALUES (1);

clearSeeded:
DELETE FROM ingredientSeed;
